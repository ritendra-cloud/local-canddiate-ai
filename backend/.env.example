APP_NAME=Local CandidateAI
APP_HOST=127.0.0.1
APP_PORT=8000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_CHAT_MODEL=qwen2.5-coder:7b
OLLAMA_JOB_MATCH_MODEL=qwen2.5-coder:7b
OLLAMA_JOB_MATCH_FALLBACK_MODEL=
CANDIDATE_PROFILE_PATH=../data/processed/candidate.json
RESUME_PATH=../data/source/resume.docx
DATABASE_PATH=./app/db/candidate_ai.db
MAX_USER_MESSAGE_LENGTH=5000
MAX_JOB_DESCRIPTION_LENGTH=20000
MAX_HISTORY_MESSAGES=12
STORE_CONVERSATIONS=true
LOG_LEVEL=INFO
CHAT_TEMPERATURE=0.1
CHAT_NUM_CTX=16384
CHAT_NUM_PREDICT=1000
CHAT_TOP_P=0.9
CHAT_REPEAT_PENALTY=1.1
JOB_MATCH_NUM_CTX=16384
JOB_MATCH_NUM_PREDICT=2048
JOB_MATCH_TEMPERATURE=0
JOB_MATCH_REQUIREMENT_BATCH_SIZE=2
